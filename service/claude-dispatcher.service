[Unit]
Description=Claude Dispatcher Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude
WorkingDirectory=/opt/claude-dispatcher
ExecStart=/opt/claude-dispatcher/venv/bin/python bot.py
Restart=on-failure
RestartSec=10
EnvironmentFile=/opt/claude-dispatcher/.env

[Install]
WantedBy=multi-user.target
